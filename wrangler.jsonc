{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ops-toolbox",
  // 与 Node 共用同一个入口：导出的都是 { fetch(request, env, ctx) }
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // 静态资源：public/ 直接托管，未命中文件且不是 /api/* 时才进入 Worker
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
